# CyprusWay web — environment
#
# The Supabase publishable key is public by design: it identifies the project and is
# constrained by RLS, not by secrecy. It lives here rather than in source so it is
# configured per environment. Vite inlines every VITE_* variable at build time, so
# the built bundle contains the value — that is expected for a publishable key.
#
# Where to get it: Supabase dashboard -> Project Settings -> API Keys -> Publishable key.
# (Not the legacy anon JWT, eyJ...: it is being retired; npm run check:env refuses it.)
#
# IMPORTANT: these must ALSO be set in the Cloudflare build environment. Vite reads
# them at build time, not at request time, so a deployment built without them ships a
# bundle with `undefined` credentials and every auth call fails at runtime.

VITE_SUPABASE_URL=https://knvjmsnwzskbageetbam.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_znQiLtzLTwrvBVxLTs4tXA_SdLD97OA
