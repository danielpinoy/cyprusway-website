{
  "name": "cyprusway-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "predev": "node scripts/check-env.mjs",
    "dev": "vite",
    "prebuild": "node scripts/check-env.mjs",
    "build": "npm run build:client && npm run build:server && npm run prerender && npm run check:css && npm run check:contrast",
    "build:client": "vite build --outDir dist",
    "build:server": "vite build --ssr src/entry-server.tsx --outDir dist-ssr",
    "prerender": "node scripts/prerender.mjs",
    "check:css": "node scripts/check-logical-css.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "typecheck": "tsc --noEmit",
    "preview": "wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "port-i18n": "node scripts/port-i18n.mjs",
    "check:env": "node scripts/check-env.mjs",
    "setup:env": "node -e \"const f=require('fs');if(f.existsSync('.env')){console.log('.env already exists — left untouched');}else{f.copyFileSync('.env.example','.env');console.log('created .env from .env.example — now fill in VITE_SUPABASE_ANON_KEY');}\""
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.4",
    "lucide-react": "^1.34.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-router": "^7.18.2"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "wrangler": "^4.127.0"
  }
}
